"\u30a8\u30b9\u30c6\u30eb\u3001\u3053\u3093\u306b\u3061\u306f\u3002One More Mile \u306e\u30de\u30eb\u30c1\u306e\u753b\u9762\u306b\u3001\u65b0\u3057\u3044\u6587\u3092 5 \u884c\u8ffd\u52a0\u3057\u307e\u3059\u3002\u8a33\u3092\u304a\u9858\u3044\u3057\u307e\u3059(\u65e5\u672c\u8a9e\u306f\u3053\u306e\u307e\u307e\u3067\u3059)\u3002\n\n\u3010\u539f\u6587(ID\u30fb\u65e5\u672c\u8a9e\u30fb\u4f7f\u3046\u5834\u6240)\u3011\n11119\t{0}\u4f4d / {1}\u4eba\t(\u30de\u30eb\u30c1 VERSUS \u306e\u30e9\u30f3\u4e2d\u3001\u5de6\u4e0a\u306e\u53c2\u52a0\u8005\u306e\u6b04\u306e\u898b\u51fa\u3057\u306e\u4e0b\u306b\u5e38\u306b\u51fa\u3059\u81ea\u5206\u306e\u9806\u4f4d\u3002{0}=\u9806\u4f4d\u306e\u6570\u5b57\u3001{1}=\u4eba\u6570\u3002\u5f8c\u308d\u306b\u300c\u5148\u982d\u307e\u3067 {0}m\u300d\u304b\u300c\u5148\u982d\u300d\u304c\u7d9a\u304f\u3002\u77ed\u304f)\n11120\t\u8d70\u884c\u4f4d\u7f6e {0} / {1}\t(\u30de\u30eb\u30c1 CO-OP \u306e\u30e9\u30f3\u4e2d\u3001\u540c\u3058\u5834\u6240\u306b\u51fa\u3059\u81ea\u5206\u306e\u30b3\u30fc\u30b9\u4e0a\u306e\u4e26\u3073\u9806(\u30c1\u30fc\u30e0\u306e\u8ddd\u96e2\u306f\u5168\u54e1\u540c\u3058\u306a\u306e\u3067\u3001\u5b9f\u969b\u306e\u4f4d\u7f6e\u3067\u306e\u524d\u304b\u3089\u4f55\u756a\u76ee\u304b)\u3002{0}=\u4f55\u756a\u76ee\u3001{1}=\u4eba\u6570\u3002\u77ed\u304f)\n11121\t\u5148\u982d\u307e\u3067 {0}m\t(\u4e0a\u306e2\u3064\u306e\u5f8c\u308d\u306b\u7d9a\u304f\u3002\u8d70\u3063\u3066\u3044\u308b\u4eba\u306e\u4e00\u756a\u524d\u307e\u3067\u306e\u8ddd\u96e2\u306e\u5dee\u3002{0}=\u30e1\u30fc\u30c8\u30eb\u306e\u6570\u5b57(1,250 \u306e\u3088\u3046\u306b\u533a\u5207\u308a\u6e08\u307f))\n11122\t\u5148\u982d\t(\u81ea\u5206\u304c\u8d70\u3063\u3066\u3044\u308b\u4eba\u306e\u4e00\u756a\u524d\u306e\u6642\u3001\u4e0a\u306e\u5dee\u306e\u4ee3\u308f\u308a\u306b\u51fa\u3059\u4e00\u8a9e)\n11123\tHOST\u304c\u8131\u51fa\u306b\u6210\u529f\u3057\u307e\u3057\u305f\t(\u30de\u30eb\u30c1\u306e\u30e9\u30f3\u4e2d\u3001HOST \u304c\u8131\u51fa\u306b\u6210\u529f\u3057\u3066\u30e9\u30f3\u304c\u5168\u54e1\u30af\u30ea\u30a2\u306b\u306a\u3063\u305f\u6642\u3001\u307b\u304b\u306e\u4eba\u306e\u753b\u9762\u4e2d\u592e\u306b\u51fa\u308b\u77ed\u3044\u77e5\u3089\u305b(2.5\u79d2)\u3002HOST \u306f\u305d\u306e\u307e\u307e\u82f1\u5b57\u306e\u5f79\u540d)\n\n\u3010\u6c7a\u307e\u308a\u3011\n\u30fb11119\u301c11122 \u306f\u8d70\u308a\u306a\u304c\u3089\u4e00\u77ac\u3067\u8aad\u3080 HUD \u306e1\u884c(\u5de6\u4e0a\u306e\u5c0f\u3055\u306a\u6b04\u306e\u4e2d\u3001\u5e45\u304c\u72ed\u3044)\u3002\u3067\u304d\u308b\u3060\u3051\u77ed\u304f\u3002{0} {1} \u306f\u305d\u306e\u307e\u307e\u6b8b\u3059(\u9806\u756a\u306f\u8a00\u8a9e\u306b\u5408\u308f\u305b\u3066\u5165\u308c\u66ff\u3048\u3066\u3088\u3044)\u3002\n\u30fb11119 \u306f\u300c\u4f55\u4f4d / \u4f55\u4eba\u4e2d\u300d\u300111120 \u306f\u300c\u30b3\u30fc\u30b9\u4e0a\u3067\u524d\u304b\u3089\u4f55\u756a\u76ee / \u4f55\u4eba\u4e2d\u300d(\u9806\u4f4d\u3067\u306f\u306a\u304f\u4e26\u3073\u9806)\u30022\u3064\u306e\u9055\u3044\u304c\u5206\u304b\u308b\u8a00\u3044\u65b9\u306b\u3002\n\u30fb11121 \u3068 11122 \u306f\u540c\u3058\u5834\u6240\u306b\u5165\u308c\u66ff\u308f\u3063\u3066\u51fa\u308b(\u5148\u982d\u3067\u306a\u3044\u6642\u306f\u5dee\u3001\u5148\u982d\u306e\u6642\u306f\u4e00\u8a9e)\u300211122 \u306f 11121 \u306e\u300c\u5148\u982d\u300d\u3068\u540c\u3058\u8a00\u8449\u306b\u3002\n\u30fb11123 \u306e HOST \u306f\u82f1\u5b57\u306e\u307e\u307e\u3002\u4e3b\u8a9e(\u79c1/\u3042\u306a\u305f)\u306f\u4ed8\u3051\u306a\u3044\u3002\n\u30fb\u7528\u8a9e\u306f\u4e0b\u306e\u65e2\u5b58\u306e\u8a33(\u540c\u3058\u30de\u30eb\u30c1\u306e\u753b\u9762\u306e\u6587)\u3068\u305d\u308d\u3048\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u3010\u65e2\u5b58\u306e\u8a33(\u8a00\u3044\u56de\u3057\u3092\u305d\u308d\u3048\u308b\u53c2\u8003)\u3011\u9806\u306b: \u4ef2\u9593\u306b\u5408\u6d41\u3057\u307e\u3057\u305f / \u3053\u306e\u307e\u307e\u8d70\u308b / \u8131\u51fa\u6210\u529f\uff01\nar\t\u062a\u0645 \u0627\u0644\u0644\u062d\u0627\u0642 \u0628\u0627\u0644\u0641\u0631\u064a\u0642\t\u